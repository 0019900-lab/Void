{"1": [[{"who": "lumi", "name": "لومي", "t": "أنا لومي. ده بئر التكوين، والباب في آخره."}, {"who": "void", "name": "فويد", "t": "طيب. بس أنا جعان."}], [{"who": "lumi", "name": "لومي", "t": "المادة الدهبية بتسد الفتحة. اضغط بلع."}], [{"who": "void", "name": "فويد", "t": "كبرت. والفتحة اللي قدامي ضيقة."}, {"who": "lumi", "name": "لومي", "t": "اندفع عشان تفرّغ الكتلة."}]], "2": [[{"who": "lumi", "name": "لومي", "t": "الفتحات الضيقة ما بتعدّيش الكتلة الكبيرة."}], [{"who": "void", "name": "فويد", "t": "الاندفاع بيرمي الكتلة."}], [{"who": "void", "name": "فويد", "t": "كل، اندفع، عدّي. فهمت."}, {"who": "lumi", "name": "لومي", "t": "وكل فتحة ضيقة بتعلّمك ده تاني."}]], "3": [[{"who": "lumi", "name": "لومي", "t": "الكرات الحمرا قاتلة. اتفرج على حركتها الأول."}], [{"who": "void", "name": "فويد", "t": "إيه الشبح ده؟"}, {"who": "lumi", "name": "لومي", "t": "أثر محاولتك. كل موتة بتسيب أثر."}], [{"who": "lumi", "name": "لومي", "t": "بترجع لآخر نقطة رجوع. وخد الدرع، بيستحمل ضربة."}]], "4": [[{"who": "guard", "name": "الحارس", "t": "الباب مقفول. محتاج تصريح."}], [{"who": "void", "name": "فويد", "t": "معنديش تصريح."}, {"who": "lumi", "name": "لومي", "t": "ده الحارس. بيمشي بالقوانين بس."}], [{"who": "guard", "name": "الحارس", "t": "ده الختم الرسمي!"}, {"who": "void", "name": "فويد", "t": "كان بيسد الباب."}]], "5": [[{"who": "lumi", "name": "لومي", "t": "الخط المتقطع آمن. المضيء قاتل."}], [{"who": "void", "name": "فويد", "t": "يعني أستنى لما يتقطع."}], [{"who": "lumi", "name": "لومي", "t": "بالظبط. عدّيت."}]], "6": [[{"who": "void", "name": "فويد", "t": "كل دول أنا؟"}, {"who": "lumi", "name": "لومي", "t": "محاولاتك السابقة. بتمشي معاك."}], [{"who": "lumi", "name": "لومي", "t": "خد تمدد الزمن. بيبطّأ النبض والكرات بس."}], [{"who": "void", "name": "فويد", "t": "أنا بتحرك عادي وهم بطيئين."}]], "7": [[{"who": "lumi", "name": "لومي", "t": "الشارة دي بتاعتي. كنت مساعدة الحارس."}], [{"who": "void", "name": "فويد", "t": "وسبتيه ليه؟"}, {"who": "lumi", "name": "لومي", "t": "كان بيقفل كل الأبواب. أنا عايزة حد يفتحها."}], [{"who": "void", "name": "فويد", "t": "أنا هفتحها."}, {"who": "lumi", "name": "لومي", "t": "شكراً يا فويد."}]], "8": [[{"who": "guard", "name": "الحارس", "t": "محاولاتك كتير جداً. ده خارج التوقعات."}], [{"who": "void", "name": "فويد", "t": "كل محاولة علمتني حاجة."}], [{"who": "guard", "name": "الحارس", "t": "مسجّل. كمّل."}]], "9": [[{"who": "lumi", "name": "لومي", "t": "التيارات بتزقك لجنب. الاندفاع بيقاومها."}], [{"who": "void", "name": "فويد", "t": "هقاومه بالاندفاع."}], [{"who": "lumi", "name": "لومي", "t": "الطيف بيعدّيك من الأحمر ثانية وشوية. استخدمه بحساب."}]], "10": [[{"who": "guard", "name": "الحارس", "t": "موظف الشهر. أكتر واحد جرّب عندنا."}], [{"who": "void", "name": "فويد", "t": "ده تكريم؟"}, {"who": "guard", "name": "الحارس", "t": "تكريم. وبيتحسب إنجاز."}], [{"who": "lumi", "name": "لومي", "t": "إنجاز جديد اتفتح."}]], "11": [[{"who": "lumi", "name": "لومي", "t": "الكتلة الكبيرة ممكن تتفجر. خد انفجار الكتلة."}], [{"who": "void", "name": "فويد", "t": "ابلع كتير. وبعدين أفجّر."}], [{"who": "lumi", "name": "لومي", "t": "الكرات حواليك اتدمرت."}]], "12": [[{"who": "guard", "name": "الحارس", "t": "ده آخر باب. بعده مفيش حواجز."}], [{"who": "void", "name": "فويد", "t": "تيجي معايا؟"}, {"who": "lumi", "name": "لومي", "t": "طبعاً."}], [{"who": "guard", "name": "الحارس", "t": "أخيراً. أقفل المكتب."}]]}