[
 {
  "level": 1,
  "title": "صحيت",
  "panels": [
   {
    "art": "s01_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "أنا لومي. ده بئر التكوين، والباب في آخره على اليمين."
     },
     {
      "speaker": "فويد",
      "text": "طيب. بس ليه كل ده؟"
     }
    ]
   },
   {
    "art": "s01_2.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "اضغط نط. ولو ضغطت تاني وإنت في الهوا هتنط نطة تانية."
     }
    ]
   },
   {
    "art": "s01_3.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "إيه الشبح ده؟"
     },
     {
      "speaker": "لومي",
      "text": "أثر محاولتك. كل موتة بتسيب أثر، ونقطة الرجوع بتحفظ تقدمك."
     }
    ]
   }
  ]
 },
 {
  "level": 2,
  "title": "الاندفاع",
  "panels": [
   {
    "art": "s02_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "خد الاندفاع. بيرميك لقدام في لحظة."
     }
    ]
   },
   {
    "art": "s02_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "ده سريع!"
     }
    ]
   },
   {
    "art": "s02_3.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "النطة التقيلة بتتعدي بالاندفاع. جرّب تجمعهم."
     }
    ]
   }
  ]
 },
 {
  "level": 3,
  "title": "الحيطان",
  "panels": [
   {
    "art": "s03_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "الحيطان البنفسجي تقدر تتعلق فيها وتنط منها."
     }
    ]
   },
   {
    "art": "s03_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "أنط من حيطة لحيطة؟"
     },
     {
      "speaker": "لومي",
      "text": "بالظبط. وماتبقاش تقع."
     }
    ]
   },
   {
    "art": "s03_3.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "كل دول أنا؟"
     },
     {
      "speaker": "لومي",
      "text": "محاولاتك السابقة. هتشوفهم كلهم لما تكسب."
     }
    ]
   }
  ]
 },
 {
  "level": 4,
  "title": "الحارس الأول",
  "panels": [
   {
    "art": "s04_1.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "الباب مقفول. محتاج تصريح."
     }
    ]
   },
   {
    "art": "s04_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "معنديش تصريح."
     },
     {
      "speaker": "لومي",
      "text": "خد الدرع. بيستحمل ضربة واحدة."
     }
    ]
   },
   {
    "art": "s04_3.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "استنى! ده مش مسموح!"
     },
     {
      "speaker": "فويد",
      "text": "كان بيسد الباب."
     }
    ]
   }
  ]
 },
 {
  "level": 5,
  "title": "بوابات النبض",
  "panels": [
   {
    "art": "s05_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "الخط المتقطع آمن. المضيء قاتل."
     }
    ]
   },
   {
    "art": "s05_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "يعني أستنى لما يتقطع."
     }
    ]
   },
   {
    "art": "s05_3.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "بالظبط. عدّيت."
     }
    ]
   }
  ]
 },
 {
  "level": 6,
  "title": "حقل الأصداء",
  "panels": [
   {
    "art": "s06_1.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "كل دول أنا؟"
     },
     {
      "speaker": "لومي",
      "text": "محاولاتك السابقة. بتمشي معاك."
     }
    ]
   },
   {
    "art": "s06_2.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "خد البلع. المادة الدهبية بتسد الطريق."
     }
    ]
   },
   {
    "art": "s06_3.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "كده الطريق اتفتح."
     }
    ]
   }
  ]
 },
 {
  "level": 7,
  "title": "سر لومي",
  "panels": [
   {
    "art": "s07_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "الشارة دي بتاعتي. كنت مساعدة الحارس."
     }
    ]
   },
   {
    "art": "s07_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "وسبتيه ليه؟"
     },
     {
      "speaker": "لومي",
      "text": "كان بيقفل كل الأبواب. أنا عايزة حد يفتحها."
     }
    ]
   },
   {
    "art": "s07_3.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "أنا هفتحها."
     },
     {
      "speaker": "لومي",
      "text": "شكراً يا فويد."
     }
    ]
   }
  ]
 },
 {
  "level": 8,
  "title": "مكتب النبض",
  "panels": [
   {
    "art": "s08_1.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "محاولاتك كتير جداً. ده خارج التوقعات."
     }
    ]
   },
   {
    "art": "s08_2.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "خد الطيف. بيعدّيك من الأحمر الرفيع ثانية وشوية."
     }
    ]
   },
   {
    "art": "s08_3.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "مسجّل. كمّل."
     }
    ]
   }
  ]
 },
 {
  "level": 9,
  "title": "نهر الجاذبية",
  "panels": [
   {
    "art": "s09_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "التيارات بتزقك لجنب. خد تباطؤ الزمن."
     }
    ]
   },
   {
    "art": "s09_2.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "بيبطّأ كل الحواجز لثواني، وإنت بتتحرك عادي."
     }
    ]
   },
   {
    "art": "s09_3.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "أنا بتحرك عادي وهم بطيئين."
     }
    ]
   }
  ]
 },
 {
  "level": 10,
  "title": "جايزة موظف الشهر",
  "panels": [
   {
    "art": "s10_1.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "موظف الشهر. أكتر واحد جرّب عندنا."
     }
    ]
   },
   {
    "art": "s10_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "ده تكريم؟"
     },
     {
      "speaker": "الحارس",
      "text": "تكريم. وبيتحسب إنجاز."
     }
    ]
   },
   {
    "art": "s10_3.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "إنجاز جديد اتفتح."
     }
    ]
   }
  ]
 },
 {
  "level": 11,
  "title": "مصهر الكتلة",
  "panels": [
   {
    "art": "s11_1.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "الكتلة اللي بلعتها تتجمع. خد انفجار الكتلة."
     }
    ]
   },
   {
    "art": "s11_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "ابلع كتير. وبعدين أفجّر."
     }
    ]
   },
   {
    "art": "s11_3.jpg",
    "lines": [
     {
      "speaker": "لومي",
      "text": "الحواجز حواليك اتدمرت."
     }
    ]
   }
  ]
 },
 {
  "level": 12,
  "title": "باب الأفق",
  "panels": [
   {
    "art": "s12_1.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "ده آخر باب. بعده مفيش حواجز."
     }
    ]
   },
   {
    "art": "s12_2.jpg",
    "lines": [
     {
      "speaker": "فويد",
      "text": "تيجي معايا؟"
     },
     {
      "speaker": "لومي",
      "text": "طبعاً."
     }
    ]
   },
   {
    "art": "s12_3.jpg",
    "lines": [
     {
      "speaker": "الحارس",
      "text": "أخيراً. أقفل المكتب."
     }
    ]
   }
  ]
 }
]